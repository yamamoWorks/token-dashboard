<main class="compact-display" aria-label="Token usage and limits">
  <section class="compact-screen" aria-label="3.5-inch compact display">
    {{#if available}}
      <header class="token-strip" aria-label="Today tokens and cost">
        {{#each tokens}}
          {{#if @first}}
            <div class="token-main">
              <span class="token-label">{{label}}</span>
              <strong class="token-count" title="{{tokensText}}">{{tokensText}}</strong>
            </div>
            <span class="token-cost">{{costText}}</span>
          {{/if}}
        {{/each}}
      </header>
      <section class="provider-grid" aria-label="Usage limits">
        {{#each gaugePanels}}
          <article class="provider-card" aria-label="{{provider}} usage">
            <header class="provider-heading">
              {{#if icon}}<img class="provider-icon" src="{{icon}}" alt="" />{{/if}}
              <strong class="provider-name" title="{{provider}}">{{provider}}</strong>
              <span class="provider-plan" title="{{plan}}">{{plan}}</span>
            </header>
            <div class="meter-area">
              <svg class="meter" viewBox="0 0 200 200" role="img" aria-label="{{provider}} remaining">
                {{!-- Keep each window in the same SVG parent. CSS :nth-of-type counts across
                       circles; Handlebars @first would restart for every circle. --}}
                {{#each circles}}
                  {{#each windows}}
                    <g class="window-ring" data-window-id="{{id}}" aria-label="{{label}} {{percentText}}">
                      <path class="ring-track ring-outer" pathLength="100" d="M 36.3604 163.6396 A 90 90 0 1 1 163.6396 163.6396" />
                      <path class="ring-track ring-inner" pathLength="100" d="M 49.0883 150.9117 A 72 72 0 1 1 150.9117 150.9117" />
                      {{#if hasRemaining}}
                        <path class="ring-fill ring-outer tone-{{tone}}" data-meter-fill pathLength="100" stroke-dasharray="{{remainingPercent}} 100" d="M 36.3604 163.6396 A 90 90 0 1 1 163.6396 163.6396" />
                        <path class="ring-fill ring-inner tone-{{tone}}" data-meter-fill pathLength="100" stroke-dasharray="{{remainingPercent}} 100" d="M 49.0883 150.9117 A 72 72 0 1 1 150.9117 150.9117" />
                      {{/if}}
                    </g>
                  {{/each}}
                {{/each}}
              </svg>
              <div class="meter-values">
                {{#each circles}}
                  {{#each windows}}
                    <div class="meter-value"><strong>{{percentText}}</strong><span>{{durationLabel}}</span></div>
                  {{/each}}
                {{/each}}
              </div>
            </div>
            <div class="window-details">
              {{#each circles}}
                {{#each windows}}
                  <div class="window-detail" title="{{label}} / {{durationLabel}} / {{resetText}}">
                    <span class="window-identity">
                      <span class="duration-label">{{durationLabel}}</span>
                      <span class="original-label">{{label}}</span>
                    </span>
                    <span class="reset-time">
                      <svg class="clock" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" /><path d="M 8 4 V 8 L 11 10" /></svg>
                      <span>{{resetText}}</span>
                    </span>
                  </div>
                {{/each}}
              {{/each}}
            </div>
          </article>
        {{/each}}
      </section>
      {{#unless gaugePanels}}<p class="empty-limits">No usage limits</p>{{/unless}}
    {{else}}
      <div class="waiting">{{waitingMessage}}</div>
    {{/if}}
  </section>
</main>
